# Copy this file to .env.local and fill in the values. On Vercel, paste the same names under
# Project → Settings → Environment Variables. Never commit real keys.

# --- Clerk (login) — dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Supabase (database + file storage) — Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- AssemblyAI (speech to text)
ASSEMBLY_AI_KEY=

# --- AI writing. Any provider that speaks the "OpenAI chat" format. Pick ONE:
#   OpenRouter:     AI_BASE_URL=https://openrouter.ai/api/v1                          # Backups are tried in order if a model fails or is too slow.
AI_MODEL=baidu/ernie-5.5-flash-preview:free,particle-ai/particle-1:free,recursive/flint-v1.0:free,dots-studio/dots-3-note-preview:free
#   Google Gemini:  AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   AI_MODEL=gemini-2.5-flash   (free tier)
#   Groq:           AI_BASE_URL=https://api.groq.com/openai/v1                        AI_MODEL=llama-3.3-70b-versatile (free tier)
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
# Backups are tried in order if a model fails or is too slow.
AI_MODEL=baidu/ernie-5.5-flash-preview:free,particle-ai/particle-1:free,recursive/flint-v1.0:free,dots-studio/dots-3-note-preview:free

# --- Exa (optional). Turns on "Research the web first" for scripts.
EXA_API_KEY=
